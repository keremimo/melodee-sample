@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix pset: <http://lv2plug.in/ns/ext/presets#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:melodee:test:tone>
    a lv2:Plugin ;
    lv2:binary <tone.so> ;
    rdfs:seeAlso <tone.ttl> .

<urn:melodee:test:tone#quiet>
    a pset:Preset ;
    lv2:appliesTo <urn:melodee:test:tone> ;
    rdfs:seeAlso <presets.ttl> .

<urn:melodee:test:tone#loud>
    a pset:Preset ;
    lv2:appliesTo <urn:melodee:test:tone> ;
    rdfs:seeAlso <presets.ttl> .
